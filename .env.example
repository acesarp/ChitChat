# Copy this file to .env (gitignored) and set real passwords before running
# `docker compose up`. Must satisfy SQL Server's complexity policy (8+ chars,
# upper+lower+digit or symbol).

# For admin access only (SSMS, etc.) -- the app itself does not use this.
MSSQL_SA_PASSWORD=change_me

# Dedicated least-privilege login for the app (only the grants in ops/sql/init-app-login.sql).
# After first bringing mssql up, provision it with:
#   sqlcmd -S <host>,<port> -U sa -P <sa password> -C -v AppPassword="<this password>" -i ops/sql/init-app-login.sql
MSSQL_APP_PASSWORD=change_me

# Optional: host port for the app (default 8080 if unset)
# APP_PORT=8080

# Optional: host port for SQL Server, e.g. for connecting with SSMS (default 1433 if unset)
# MSSQL_PORT=1433
