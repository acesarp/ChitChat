<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backup only, and trimmed to this project's own rule. The live file at
  C:\inetpub\wwwroot\web.config on the Windows Server also proxies a few other,
  unrelated apps on guto.ca's Default Web Site -- those rules are deliberately left out
  of this copy since they aren't part of this repo and this repo is public. If you
  change the "Chat" rule below, hand-edit the live file too (or merge this one into it,
  don't overwrite it) and restart IIS / recycle the app pool.

  LAN_HOST below is a private (RFC1918), non-internet-routable address on the home
  server this app deploys to -- replace with your own reverse-proxy target.
-->
<configuration>
    <system.webServer>
        <defaultDocument>
            <files>
                <clear />
                <add value="iisstart.htm" />
                <add value="Default.htm" />
                <add value="Default.asp" />
                <add value="index.htm" />
                <add value="index.html" />
            </files>
        </defaultDocument>
        <rewrite>
            <rules>
                <rule name="Chat Slash" stopProcessing="true">
                    <match url="^chat$" />
                    <action type="Redirect" url="/chat/" redirectType="Found" />
                </rule>
                <rule name="Chat" stopProcessing="true">
                    <match url="^chat/(.*)" />
                    <action type="Rewrite" url="http://LAN_HOST:8080/{R:1}" />
                    <serverVariables>
                        <set name="HTTP_SEC_WEBSOCKET_EXTENSIONS" value="" />
                    </serverVariables>
                </rule>
            </rules>
        </rewrite>
    </system.webServer>
</configuration>
