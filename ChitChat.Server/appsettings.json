{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/chitchat-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ChitChat"
    }
  },
  "DatabaseLogging": {
    "MinimumLevel": "Information"
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Chat": "Server=localhost,1433;Database=ChatDb;User Id=sa;Password=LocalDev_Pa55w0rd!;TrustServerCertificate=True"
  }
